{
  "manifest_version": 3,
  "name": "Open Browser Use",
  "description": "Open Browser Use automation extension for Zen Browser and Firefox.",
  "version": "0.1.42",
  "browser_specific_settings": {
    "gecko": {
      "id": "open-browser-use@ifuryst.com",
      "strict_min_version": "136.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Browser Use",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": ["firefox-compat.js", "background.js"],
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self';"
  },
  "host_permissions": ["<all_urls>"],
  "optional_permissions": ["userScripts"],
  "web_accessible_resources": [
    {
      "resources": ["images/cursor-chat.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "alarms",
    "downloads",
    "history",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ]
}
